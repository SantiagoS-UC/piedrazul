@startuml c4-4c-codigo-frontend
!pragma layout smetana
skinparam defaultFontName Arial
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam ClassBackgroundColor white
skinparam ClassBorderColor #1168BD
skinparam ClassFontColor #1168BD
skinparam ClassBorderThickness 1.3
skinparam PackageBorderColor #666666
skinparam PackageBackgroundColor white
skinparam ArrowColor #444444
skinparam ArrowFontSize 11
skinparam TitleFontSize 18
skinparam TitleFontColor #333333
hide empty members
hide circle
set separator none

title Diagrama de clases: páginas del personal\n<size:12><color:#666666>Modelo C4, nivel 4</color></size>

package "features/staff" {
  class ExportAppointmentsPage {
    #export() : void
  }
  class PatientHistoryPage {
    #search(text) : void
    #choose(option) : void
  }
  class AgendaApi {
    +getAgenda(professionalId, date)
    +exportAgenda(professionalId, date)
  }
  class PatientHistoryApi {
    +searchByDocument(document)
    +getHistory(patientId)
  }
}
package "shared/ui" {
  class Combobox {
    +options
    +selected
  }
}
package "core/auth" {
  class AuthSession {
    +role
    +login()
    +freshToken()
  }
}

ExportAppointmentsPage ..> AgendaApi
ExportAppointmentsPage ..> AuthSession
PatientHistoryPage ..> PatientHistoryApi
PatientHistoryPage *-- Combobox
@enduml
