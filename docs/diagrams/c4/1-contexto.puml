@startuml c4-1-contexto

' Diagrama C4 nivel 1 (contexto) del sistema Piedrazul
' Muestra los actores del sistema y su relación con Keycloak

!pragma layout smetana
sprite $person [48x48/16z] {
xTF14K1040LH6Kp-sQe-_wrH3O2-W0VOdHvHaTFaD2bEuj73DppMEnyRFO_Dztd_VVptz__NZnyIlCOvJOgJv7b2xEqFZNHtD7bxk1Rz--VHx_ruyEFDZsS_
N_ny9CN9SHBwg6O
}
sprite $system [48x48/16z] OnWPO1JmumVegWa3LEKaQU0d3g2g9-mxD0xH6i1CGc1K_QZwKVMavIzIyo-2Ht61Gdc1HMBvEIJ1A

!$PERSONA = "#white;line:2F7D1A;line.bold;text:2F7D1A"
!$AZUL = "#white;line:1168BD;line.bold;text:1168BD"
!$LIMITE = "#white;line:1168BD;text:1168BD"
!$MODULO = "#white;line:1168BD;line.dashed;text:1168BD"
!$EXTERNO = "#white;line:7A7A7A;line.bold;text:5C5C5C"

skinparam defaultFontName Arial
skinparam shadowing false
skinparam roundCorner 20
skinparam wrapWidth 210
skinparam defaultTextAlignment center
skinparam componentStyle uml1
skinparam ArrowColor #444444
skinparam ArrowFontColor #444444
skinparam ArrowFontSize 11
skinparam ArrowThickness 1.3
skinparam DatabaseBorderThickness 2
skinparam TitleFontSize 18
skinparam TitleFontColor #333333
skinparam LegendBackgroundColor white
skinparam LegendBorderColor #999999
skinparam LegendFontColor #444444
skinparam LegendFontSize 12

title Diagrama de contexto: Piedrazul\n<size:12><color:#666666>Modelo C4, nivel 1</color></size>

person "<size:16><b>Paciente</b></size>\n<size:10>[Persona]</size>\n\nAgenda sus citas." as paciente $PERSONA
person "<size:16><b>Agendador</b></size>\n<size:10>[Persona]</size>\n\nGestiona las citas de la clínica." as agendador $PERSONA
person "<size:16><b>Profesional</b></size>\n<size:10>[Persona]</size>\n\nMédico o terapista." as profesional $PERSONA
person "<size:16><b>Administrador</b></size>\n<size:10>[Persona]</size>\n\nConfigura el sistema." as administrador $PERSONA

rectangle "<$system{scale=0.6,color=#1168BD}>\n<size:18><b>Sistema de citas Piedrazul</b></size>\n<size:10>[Sistema de software]</size>\n\nAgendamiento y consulta de citas médicas." as piedrazul $AZUL
rectangle "<$system{scale=0.6,color=#7A7A7A}>\n<size:16><b>Keycloak</b></size>\n<size:10>[Sistema externo]</size>\n\nUsuarios, roles y tokens." as keycloak $EXTERNO

paciente -[dashed]-> piedrazul : "Agenda citas"
agendador -[dashed]-> piedrazul : "Lista, exporta y\nconsulta citas"
profesional -[dashed]-> piedrazul : "Exporta su agenda y\nconsulta historiales"
administrador -[dashed]-> piedrazul : "Configura el\nagendamiento"
piedrazul -[dashed]right-> keycloak : "Autentica usuarios\n<size:10>[OpenID Connect]</size>"

legend right
  <b>Convenciones</b>
  <$person{scale=0.35,color=#2F7D1A}> Persona
  <$system{scale=0.35,color=#1168BD}> Sistema de software
  <$system{scale=0.35,color=#7A7A7A}> Sistema externo
  <color:#444444>- - - ></color> Relación
endlegend
@enduml
