sprite $person [48x48/16z] {
xTF14K1040LH6Kp-sQe-_wrH3O2-W0VOdHvHaTFaD2bEuj73DppMEnyRFO_Dztd_VVptz__NZnyIlCOvJOgJv7b2xEqFZNHtD7bxk1Rz--VHx_ruyEFDZsS_
N_ny9CN9SHBwg6O
}
sprite $browser [48x48/16z] Oo04HW4_qO2Ewe4q6icFwMeq5We9f501bTMZQy3l_e4EJyAfO5GzBZ2gVbJzg7gwb5UaQI2n1cCOYG
sprite $terminal [48x48/16z] OnW9O1JmawgUdqJbf6dW1mCIb0yw3GnaQ1YalgPTH5Fi_e5NFlISZj10VhJoOmACye4qzGoagMUWX_fHC0e
sprite $database [48x48/16z] xTMv3O0m40LHTx3zTqkCHXfh8iuVikzpWzVRCkSKwvsnDCq6jljWI6rCxOtPxf_Upv_UGxys4bwVBxsyF-AHb_ZV__xtzV_P_i_n_z_Nbz1ewwC5zjuv
sprite $system [48x48/16z] OnWPO1JmumVegWa3LEKaQU0d3g2g9-mxD0xH6i1CGc1K_QZwKVMavIzIyo-2Ht61Gdc1HMBvEIJ1A

!$PERSONA = "#white;line:2F7D1A;line.bold;text:2F7D1A"
!$AZUL = "#white;line:1168BD;line.bold;text:1168BD"
!$LIMITE = "#white;line:1168BD;text:1168BD"
!$MODULO = "#white;line:1168BD;line.dashed;text:1168BD"
!$EXTERNO = "#white;line:7A7A7A;line.bold;text:5C5C5C"

skinparam defaultFontName Arial
skinparam shadowing false
skinparam roundCorner 20
skinparam wrapWidth 210
skinparam defaultTextAlignment center
skinparam componentStyle uml1
skinparam ArrowColor #444444
skinparam ArrowFontColor #444444
skinparam ArrowFontSize 11
skinparam ArrowThickness 1.3
skinparam DatabaseBorderThickness 2
skinparam TitleFontSize 18
skinparam TitleFontColor #333333
skinparam LegendBackgroundColor white
skinparam LegendBorderColor #999999
skinparam LegendFontColor #444444
skinparam LegendFontSize 12

title Diagrama de contenedores: Piedrazul\n<size:12><color:#666666>Modelo C4, nivel 2</color></size>

person "<size:16><b>Usuario</b></size>\n<size:10>[Persona]</size>\n\nPaciente, agendador, profesional o administrador." as usuario $PERSONA

rectangle "<size:16><b>Sistema de citas Piedrazul</b></size>\n<size:10>[Sistema de software]</size>" as piedrazul $LIMITE {
  rectangle "<$browser{scale=0.6,color=#1168BD}>\n<size:16><b>Aplicación web</b></size>\n<size:10>[Angular 22]</size>\n\nInterfaz de cada rol." as spa $AZUL
  rectangle "<$terminal{scale=0.6,color=#1168BD}>\n<size:16><b>API de Piedrazul</b></size>\n<size:10>[Java 21, Spring Boot 4]</size>\n\nMonolito modular con API REST." as api $AZUL
  database "<size:16><b>Base de datos</b></size>\n<size:10>[PostgreSQL 17]</size>\n\nPacientes, profesionales, configuración y citas." as db $AZUL
}
rectangle "<$system{scale=0.6,color=#7A7A7A}>\n<size:16><b>Keycloak</b></size>\n<size:10>[Sistema externo]</size>\n\nUsuarios, roles y tokens JWT." as keycloak $EXTERNO

usuario -[dashed]-> spa : "Usa\n<size:10>[HTTPS]</size>"
spa -[dashed]-> api : "Consume\n<size:10>[JSON/HTTP, JWT]</size>"
spa -[dashed]-> keycloak : "Inicia sesión\n<size:10>[OpenID Connect]</size>"
api -[dashed]-> keycloak : "Valida tokens y\ncrea cuentas"
api -[dashed]-> db : "Lee y escribe\n<size:10>[JDBC]</size>"

legend right
  <b>Convenciones</b>
  <$person{scale=0.35,color=#2F7D1A}> Persona
  <$browser{scale=0.35,color=#1168BD}> Aplicación de una sola página
  <$terminal{scale=0.35,color=#1168BD}> Aplicación del lado del servidor
  <$database{scale=0.35,color=#1168BD}> Base de datos
  <$system{scale=0.35,color=#7A7A7A}> Sistema externo
  <color:#444444>- - - ></color> Relación
endlegend
@enduml
