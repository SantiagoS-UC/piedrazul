diff --git a/.github/workflows/cd.yml b/.github/workflows/cd.yml
new file mode 100644
index 0000000..d432afd
--- /dev/null
+++ b/.github/workflows/cd.yml
@@ -0,0 +1,51 @@
+name: CD
+
+# Despliegue continuo: cada push a main (el merge de develop al cerrar un corte) vuelve a correr
+# la integración continua y, solo si todo pasa, despliega el backend y el frontend en Render.
+on:
+  push:
+    branches: [main]
+  workflow_dispatch:
+
+concurrency:
+  group: cd-production
+  cancel-in-progress: false
+
+permissions:
+  contents: read
+
+jobs:
+  ci:
+    uses: ./.github/workflows/ci.yml
+
+  deploy:
+    name: Desplegar en Render
+    needs: ci
+    runs-on: ubuntu-latest
+    environment:
+      name: production
+      url: https://piedrazul-web.onrender.com
+    steps:
+      # Los deploy hooks son URL secretas que Render da para cada servicio; están en los secrets
+      # del repositorio, nunca en el código.
+      - name: Desplegar el backend
+        run: curl --fail --silent --show-error -X POST "${{ secrets.RENDER_DEPLOY_HOOK_API }}"
+
+      - name: Desplegar el frontend
+        run: curl --fail --silent --show-error -X POST "${{ secrets.RENDER_DEPLOY_HOOK_WEB }}"
+
+      # Prueba de humo: el backend debe quedar disponible y conectado a la base de datos. El plan
+      # gratuito tarda en construir y arrancar, por eso se reintenta durante 15 minutos.
+      - name: Verificar el estado del backend
+        run: |
+          sleep 120
+          for attempt in $(seq 1 26); do
+            if curl --fail --silent https://piedrazul-api.onrender.com/actuator/health | grep -q '"status":"UP"'; then
+              echo "Backend desplegado y en estado UP."
+              exit 0
+            fi
+            echo "Intento $attempt: el backend aún no responde UP."
+            sleep 30
+          done
+          echo "El backend no quedó en estado UP." >&2
+          exit 1
