+import { HttpRequest } from '@angular/common/http';
+import { withApiUrl } from './api-url-interceptor';
+
+describe('withApiUrl', () => {
+  const request = new HttpRequest('GET', '/api/professionals');
+
+  it('antepone la URL del backend a las rutas de la API', () => {
+    expect(withApiUrl(request, 'https://piedrazul-api.onrender.com').url).toBe(
+      'https://piedrazul-api.onrender.com/api/professionals',
+    );
+  });
+
+  it('deja la ruta relativa en desarrollo, donde la atiende el proxy', () => {
+    expect(withApiUrl(request, '').url).toBe('/api/professionals');
+  });
+
+  it('no modifica peticiones que no son de la API', () => {
+    const asset = new HttpRequest('GET', '/silent-check-sso.html');
+
+    expect(withApiUrl(asset, 'https://piedrazul-api.onrender.com').url).toBe('/silent-check-sso.html');
+  });
+});
diff --git a/frontend/src/app/core/http/api-url-interceptor.ts b/frontend/src/app/core/http/api-url-interceptor.ts
new file mode 100644
index 0000000..967f5e6
--- /dev/null
+++ b/frontend/src/app/core/http/api-url-interceptor.ts
@@ -0,0 +1,14 @@
+import { HttpInterceptorFn, HttpRequest } from '@angular/common/http';
+import { environment } from '../../../environments/environment';
+
+/**
+ * Los servicios piden rutas relativas como /api/professionals. En local se quedan así y las
+ * atiende el proxy de Angular; en producción se les antepone la URL del backend.
+ */
+export const apiUrlInterceptor: HttpInterceptorFn = (request, next) =>
+  next(withApiUrl(request, environment.apiUrl));
+
+export function withApiUrl<T>(request: HttpRequest<T>, apiUrl: string): HttpRequest<T> {
+  const isApiCall = apiUrl !== '' && request.url.startsWith('/api/');
+  return isApiCall ? request.clone({ url: `${apiUrl}${request.url}` }) : request;
+}
