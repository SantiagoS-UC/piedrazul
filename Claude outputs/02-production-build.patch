@@ -0,0 +1,44 @@
+# Blueprint de Render: describe los servicios de Piedrazul en la nube. Render lo lee desde
+# "New > Blueprint" y crea los servicios. Los valores secretos (sync: false) se escriben en el
+# panel de Render, nunca en el repositorio.
+services:
+  - type: web
+    name: piedrazul-api
+    runtime: docker
+    plan: free
+    region: virginia
+    dockerfilePath: ./backend/Dockerfile
+    dockerContext: ./backend
+    healthCheckPath: /actuator/health
+    # El despliegue lo dispara el workflow de despliegue continuo después de las pruebas.
+    autoDeployTrigger: "off"
+    envVars:
+      - key: DB_URL
+        sync: false
+      - key: DB_USERNAME
+        sync: false
+      - key: DB_PASSWORD
+        sync: false
+      - key: KEYCLOAK_URL
+        sync: false
+      - key: KEYCLOAK_ISSUER_URI
+        sync: false
+      - key: KEYCLOAK_CLIENT_SECRET
+        sync: false
+      - key: CORS_ALLOWED_ORIGINS
+        sync: false
+
+  - type: web
+    name: piedrazul-web
+    runtime: static
+    buildCommand: cd frontend && npm ci && npx ng build
+    staticPublishPath: ./frontend/dist/frontend/browser
+    autoDeployTrigger: "off"
+    envVars:
+      - key: NODE_VERSION
+        value: "24"
+    # La aplicación es de una sola página: cualquier ruta la resuelve index.html.
+    routes:
+      - type: rewrite
+        source: /*
+        destination: /index.html
