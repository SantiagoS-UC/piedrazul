@@ -0,0 +1,38 @@
+import { MyAppointment, splitAppointments } from './my-appointments-api';
+
+function appointment(id: string, date: string, time: string, status: MyAppointment['status']): MyAppointment {
+  return {
+    id,
+    date,
+    time,
+    durationMinutes: 30,
+    professionalName: 'Laura Martínez',
+    specialtyName: 'Medicina general',
+    status,
+    cancellable: status === 'UPCOMING',
+    cancellationReason: status === 'CANCELLED' ? 'Tengo un viaje de trabajo' : null,
+  };
+}
+
+describe('Mis citas', () => {
+  it('ordena las próximas de la más cercana a la más lejana', () => {
+    const { upcoming } = splitAppointments([
+      appointment('c', '2026-10-14', '08:00', 'UPCOMING'),
+      appointment('b', '2026-10-07', '10:00', 'UPCOMING'),
+      appointment('a', '2026-10-07', '08:30', 'UPCOMING'),
+    ]);
+
+    expect(upcoming.map((item) => item.id)).toEqual(['a', 'b', 'c']);
+  });
+
+  it('deja en el historial las pasadas y las canceladas, en el orden de la API', () => {
+    const { upcoming, others } = splitAppointments([
+      appointment('cancelada', '2026-10-20', '08:00', 'CANCELLED'),
+      appointment('proxima', '2026-10-07', '08:00', 'UPCOMING'),
+      appointment('pasada', '2026-09-01', '09:00', 'PAST'),
+    ]);
+
+    expect(upcoming.map((item) => item.id)).toEqual(['proxima']);
+    expect(others.map((item) => item.id)).toEqual(['cancelada', 'pasada']);
+  });
+});
diff --git a/frontend/src/app/features/patient/my-appointments-api.ts b/frontend/src/app/features/patient/my-appointments-api.ts
new file mode 100644
index 0000000..1265437
--- /dev/null
+++ b/frontend/src/app/features/patient/my-appointments-api.ts
@@ -0,0 +1,56 @@
+import { HttpClient } from '@angular/common/http';
+import { inject, Injectable } from '@angular/core';
+import { Observable } from 'rxjs';
+
+export type MyAppointmentStatus = 'UPCOMING' | 'PAST' | 'CANCELLED';
+
+export interface MyAppointment {
+  id: string;
+  /** aaaa-mm-dd */
+  date: string;
+  /** HH:mm */
+  time: string;
+  durationMinutes: number;
+  professionalName: string;
+  specialtyName: string;
+  status: MyAppointmentStatus;
+  /** Si todavía se puede cancelar: mínimo dos días antes de la cita. */
+  cancellable: boolean;
+  cancellationReason: string | null;
+}
+
+/** Mismas reglas que Appointment en el backend. */
+export const CANCELLATION_RULES = {
+  minDaysBefore: 2,
+  reasonMinLength: 10,
+  reasonMaxLength: 500,
+};
+
+@Injectable({ providedIn: 'root' })
+export class MyAppointmentsApi {
+  private readonly http = inject(HttpClient);
+
+  /** De la más reciente a la más antigua, incluidas las canceladas. */
+  getMine(): Observable<MyAppointment[]> {
+    return this.http.get<MyAppointment[]>('/api/appointments/mine');
+  }
+
+  cancel(appointmentId: string, reason: string): Observable<MyAppointment> {
+    return this.http.post<MyAppointment>(`/api/appointments/mine/${appointmentId}/cancel`, { reason });
+  }
+}
+
+/**
+ * Próximas primero y de la más cercana a la más lejana; el resto (pasadas y canceladas) de la más
+ * reciente a la más antigua, como las entrega la API.
+ */
+export function splitAppointments(appointments: MyAppointment[]): {
+  upcoming: MyAppointment[];
+  others: MyAppointment[];
+} {
+  const upcoming = appointments
+    .filter((appointment) => appointment.status === 'UPCOMING')
+    .sort((a, b) => `${a.date} ${a.time}`.localeCompare(`${b.date} ${b.time}`));
+  const others = appointments.filter((appointment) => appointment.status !== 'UPCOMING');
+  return { upcoming, others };
+}
